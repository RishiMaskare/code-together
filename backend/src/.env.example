# Copy this file to backend/src/.env and fill in real values. Never commit .env.

# Server
PORT=5001
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGO_URI=

# Auth
JWT_SECRET=

# Deployed frontend origin (drives CORS + cookies + OAuth redirect). No trailing slash.
# Local dev example: http://localhost:5173 ; production: https://your-app.onrender.com
FRONTEND_URL=

# Stream (Chat + Video). Key is shared with the client; SECRET is server-only.
STREAM_API_KEY=
STREAM_API_SECRET=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Gemini (AI assistant)
GEMINI_API_KEY=
