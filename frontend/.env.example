# Copy this file to frontend/.env and fill in real values. Never commit .env.
# Vite reads these at BUILD time and bakes them into the public bundle.

# Stream public app key (also set on the backend; safe to expose to the browser).
VITE_STREAM_API_KEY=

# GitHub OAuth App client id (the browser needs this to start the OAuth redirect).
# The matching SECRET lives only on the backend.
VITE_GITHUB_CLIENT_ID=

# Optional (only if you ever call these directly from the browser; in this app
# code execution and AI both go through the backend /api, so these are unused):
VITE_JUDGE0_API_URL=
VITE_GEMINI_API_KEY=
